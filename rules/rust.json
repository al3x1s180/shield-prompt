{
  "version": 2,
  "language": "rust",
  "rules": [
    {
      "ruleId": "unsafe-block",
      "severity": "warning",
      "message": "Unsafe block detected — review for memory safety issues",
      "detail": "unsafe blocks bypass Rust's memory safety guarantees. Ensure raw pointer operations are correctly bounds-checked and that invariants are upheld.",
      "cves": [
        { "id": "CWE-119", "url": "https://cwe.mitre.org/data/definitions/119.html", "description": "Buffer Overflow / Improper Memory Operations" }
      ],
      "patterns": [
        { "type": "regex", "match": "\\bunsafe\\s*\\{", "flags": "g", "context": "line" }
      ],
      "safeguards": [],
      "requiresTaint": false
    },
    {
      "ruleId": "command-injection",
      "severity": "critical",
      "message": "Command injection: user input in Command::new or arg()",
      "detail": "Passing user-controlled data to Command::new or .arg() allows arbitrary command execution.",
      "cves": [
        { "id": "CWE-78", "url": "https://cwe.mitre.org/data/definitions/78.html", "description": "OS Command Injection" }
      ],
      "patterns": [
        { "type": "regex", "match": "Command::new\\s*\\([^)]*(?:input|user|param|arg|query)", "flags": "gi", "context": "line" },
        { "type": "regex", "match": "\\.arg\\s*\\([^)]*(?:input|user|param|request)", "flags": "gi", "context": "line" },
        { "type": "regex", "match": "Command::new\\s*\\(\\s*\"(?:sh|bash|cmd|powershell)\"", "flags": "gi", "context": "multiline", "windowLines": 3 }
      ],
      "safeguards": [],
      "requiresTaint": true
    },
    {
      "ruleId": "sql-injection",
      "severity": "critical",
      "message": "Potential SQL injection via string formatting",
      "detail": "Building SQL queries with format! or string concatenation allows injection. Use sqlx parameterised queries or diesel's query DSL.",
      "cves": [
        { "id": "CWE-89", "url": "https://cwe.mitre.org/data/definitions/89.html", "description": "SQL Injection" }
      ],
      "patterns": [
        { "type": "regex", "match": "format!\\s*\\(\\s*\".*(?:SELECT|INSERT|UPDATE|DELETE|WHERE).*\\{", "flags": "gi", "context": "line" },
        { "type": "regex", "match": "query\\s*\\(\\s*&format!\\s*\\(", "flags": "gi", "context": "line" }
      ],
      "safeguards": ["sqlx::query!", "bind\\(", "\\$[0-9]", "?\\s*,"],
      "requiresTaint": true
    },
    {
      "ruleId": "path-traversal",
      "severity": "critical",
      "message": "Path traversal: user input in file operation",
      "detail": "User-controlled paths can escape the intended directory. Use Path::canonicalize and validate the result starts with the base path.",
      "cves": [
        { "id": "CWE-22", "url": "https://cwe.mitre.org/data/definitions/22.html", "description": "Path Traversal" }
      ],
      "patterns": [
        { "type": "regex", "match": "(?:File::open|fs::read|fs::write|fs::read_to_string)\\s*\\([^)]*(?:input|user|param|query)", "flags": "gi", "context": "line" },
        { "type": "regex", "match": "Path::new\\s*\\([^)]*(?:input|user|param)", "flags": "gi", "context": "line" }
      ],
      "safeguards": ["canonicalize\\(\\)", "starts_with.*base_path", "strip_prefix"],
      "requiresTaint": true
    },
    {
      "ruleId": "hardcoded-secret",
      "severity": "critical",
      "message": "Hardcoded secret or credential detected",
      "detail": "Use std::env::var() or a secrets manager instead of hardcoding credentials.",
      "cves": [
        { "id": "CWE-798", "url": "https://cwe.mitre.org/data/definitions/798.html", "description": "Use of Hard-coded Credentials" }
      ],
      "patterns": [
        { "type": "regex", "match": "(?:password|secret|api_key|token|private_key)\\s*=\\s*\"[^\"]{9,}\"", "flags": "gi", "context": "line" },
        { "type": "regex", "match": "const\\s+(?:SECRET|API_KEY|PASSWORD|TOKEN)\\s*:\\s*&str\\s*=\\s*\"[^\"]{9,}\"", "flags": "g", "context": "line" }
      ],
      "safeguards": ["env::var\\(", "std::env::var", "dotenvy", "your_", "example"],
      "requiresTaint": false,
      "entropyCheck": { "minLength": 9, "minEntropy": 2.5 }
    },
    {
      "ruleId": "weak-hash",
      "severity": "warning",
      "message": "Weak hash algorithm: MD5 or SHA-1",
      "detail": "MD5 and SHA-1 are broken. Use sha2::Sha256 or blake3.",
      "cves": [
        { "id": "CWE-327", "url": "https://cwe.mitre.org/data/definitions/327.html", "description": "Use of a Broken or Risky Cryptographic Algorithm" }
      ],
      "patterns": [
        { "type": "regex", "match": "(?:md5|sha1)::", "flags": "gi", "context": "line" },
        { "type": "regex", "match": "use\\s+md5;|use\\s+sha1;", "flags": "gi", "context": "line" }
      ],
      "safeguards": [],
      "requiresTaint": false
    },
    {
      "ruleId": "tls-verify-disabled",
      "severity": "critical",
      "message": "TLS certificate verification disabled",
      "detail": "danger_accept_invalid_certs(true) disables TLS verification, enabling MITM attacks.",
      "cves": [
        { "id": "CWE-295", "url": "https://cwe.mitre.org/data/definitions/295.html", "description": "Improper Certificate Validation" }
      ],
      "patterns": [
        { "type": "regex", "match": "danger_accept_invalid_certs\\s*\\(\\s*true\\s*\\)", "flags": "gi", "context": "line" },
        { "type": "regex", "match": "danger_accept_invalid_hostnames\\s*\\(\\s*true\\s*\\)", "flags": "gi", "context": "line" }
      ],
      "safeguards": [],
      "requiresTaint": false
    },
    {
      "ruleId": "integer-overflow",
      "severity": "warning",
      "message": "Potential integer overflow in arithmetic operation",
      "detail": "Rust panics on integer overflow in debug builds but wraps silently in release. Use checked_add/checked_mul or saturating arithmetic for untrusted inputs.",
      "cves": [
        { "id": "CWE-190", "url": "https://cwe.mitre.org/data/definitions/190.html", "description": "Integer Overflow or Wraparound" }
      ],
      "patterns": [
        { "type": "regex", "match": "(?:input|user|param|size|len|count)\\s*(?:\\*|\\+)\\s*(?:[0-9]+|\\w+)\\s*(?:as\\s+\\w+)?\\s*;", "flags": "gi", "context": "line" }
      ],
      "safeguards": ["checked_add\\(", "checked_mul\\(", "saturating_add\\(", "wrapping_add\\("],
      "requiresTaint": true
    },
    {
      "ruleId": "ssrf",
      "severity": "critical",
      "message": "SSRF: user-controlled URL in HTTP request",
      "detail": "Making HTTP requests to user-supplied URLs exposes internal services.",
      "cves": [
        { "id": "CWE-918", "url": "https://cwe.mitre.org/data/definitions/918.html", "description": "Server-Side Request Forgery" }
      ],
      "patterns": [
        { "type": "regex", "match": "reqwest::(?:get|Client.*get|Client.*post).*(?:input|user|param|query)", "flags": "gi", "context": "line" }
      ],
      "safeguards": ["allowed_hosts", "whitelist", "url::Url::parse.*host"],
      "requiresTaint": true
    },
    {
      "ruleId": "from-utf8-unchecked",
      "severity": "critical",
      "message": "from_utf8_unchecked — undefined behaviour on invalid UTF-8",
      "detail": "std::str::from_utf8_unchecked bypasses UTF-8 validation and causes undefined behaviour on invalid input. Use from_utf8() and handle the Result instead.",
      "cves": [
        { "id": "CWE-119", "url": "https://cwe.mitre.org/data/definitions/119.html", "description": "Improper Restriction of Memory Operations" }
      ],
      "patterns": [
        { "type": "regex", "match": "from_utf8_unchecked\\s*\\(", "flags": "gi", "context": "line" }
      ],
      "safeguards": ["from_utf8\\(", "String::from_utf8\\("],
      "requiresTaint": false
    },
    {
      "ruleId": "slice-from-raw-parts",
      "severity": "critical",
      "message": "slice::from_raw_parts — unsafe memory access",
      "detail": "from_raw_parts requires the caller to guarantee the pointer is valid, aligned, and the length doesn't exceed the allocation. Violations cause undefined behaviour. Prefer safe slice operations.",
      "cves": [
        { "id": "CWE-119", "url": "https://cwe.mitre.org/data/definitions/119.html", "description": "Improper Restriction of Memory Operations" }
      ],
      "patterns": [
        { "type": "regex", "match": "slice::from_raw_parts(?:_mut)?\\s*\\(", "flags": "gi", "context": "line" }
      ],
      "safeguards": [],
      "requiresTaint": false
    },
    {
      "ruleId": "log-injection",
      "severity": "warning",
      "message": "Log injection: user input written to logs without sanitisation",
      "detail": "Logging raw user input allows log forging. Strip newlines before logging.",
      "cves": [
        { "id": "CWE-117", "url": "https://cwe.mitre.org/data/definitions/117.html", "description": "Improper Output Neutralization for Logs" }
      ],
      "patterns": [
        { "type": "regex", "match": "(?:info|warn|error|debug|trace)!\\s*\\([^)]*(?:input|user|param|query)", "flags": "gi", "context": "line" }
      ],
      "safeguards": ["replace.*\\\\n", "replace.*\\\\r"],
      "requiresTaint": true
    },
    {
      "ruleId": "hardcoded-iv",
      "severity": "warning",
      "message": "Hardcoded or zero IV used in encryption",
      "detail": "Reusing an IV with the same key allows plaintext recovery. Generate a random IV with OsRng for every encryption.",
      "cves": [
        { "id": "CWE-329", "url": "https://cwe.mitre.org/data/definitions/329.html", "description": "Not Using an Unpredictable IV with CBC Mode" }
      ],
      "patterns": [
        { "type": "regex", "match": "let\\s+(?:iv|nonce)\\s*=\\s*\\[0u8;\\s*\\d+\\]", "flags": "gi", "context": "line" },
        { "type": "regex", "match": "let\\s+(?:iv|nonce)\\s*=\\s*b\"[^\"]{8,}\"", "flags": "gi", "context": "line" }
      ],
      "safeguards": ["OsRng", "rand::thread_rng\\(\\)", "rand::rngs::OsRng"],
      "requiresTaint": false
    },
    {
      "ruleId": "ldap-injection",
      "severity": "critical",
      "message": "Potential LDAP injection via user-controlled input",
      "detail": "Building LDAP filters with user input allows authentication bypass. Escape user values before inserting into filters.",
      "cves": [
        { "id": "CWE-90", "url": "https://cwe.mitre.org/data/definitions/90.html", "description": "Improper Neutralization of Special Elements in LDAP Query" }
      ],
      "patterns": [
        { "type": "regex", "match": "(?:ldap3|ldap).*(?:search|bind).*(?:input|user|param)", "flags": "gi", "context": "line" },
        { "type": "regex", "match": "format!\\s*\\(.*(?:cn=|uid=|dc=).*(?:input|user|param)", "flags": "gi", "context": "line" }
      ],
      "safeguards": ["escape_filter\\(", "escape_dn\\("],
      "requiresTaint": true
    },
    {
      "ruleId": "xpath-injection",
      "severity": "critical",
      "message": "Potential XPath injection via user-controlled input",
      "detail": "Building XPath expressions with user input allows arbitrary data access. Sanitise before use.",
      "cves": [
        { "id": "CWE-643", "url": "https://cwe.mitre.org/data/definitions/643.html", "description": "Improper Neutralization of Data within XPath Expressions" }
      ],
      "patterns": [
        { "type": "regex", "match": "(?:xpath|evaluate)\\s*\\([^)]*(?:input|user|param)", "flags": "gi", "context": "line" }
      ],
      "safeguards": ["escape\\(", "sanitize\\("],
      "requiresTaint": true
    },
    {
      "ruleId": "insecure-cookie",
      "severity": "warning",
      "message": "Cookie set without HttpOnly or Secure flag",
      "detail": "Cookies without http_only() can be stolen via XSS. Without secure() they travel over plain HTTP. Set both in the Cookie builder.",
      "cves": [
        { "id": "CWE-614", "url": "https://cwe.mitre.org/data/definitions/614.html", "description": "Sensitive Cookie Without Secure Attribute" }
      ],
      "patterns": [
        { "type": "regex", "match": "Cookie::new\\s*\\((?![^)]*http_only|[^)]*secure)", "flags": "gi", "context": "multiline", "windowLines": 4 },
        { "type": "regex", "match": "CookieBuilder.*build\\s*\\((?![^)]*http_only|[^)]*secure)", "flags": "gi", "context": "multiline", "windowLines": 4 }
      ],
      "safeguards": ["http_only\\s*\\(\\s*true", "secure\\s*\\(\\s*true", "same_site\\("],
      "requiresTaint": false
    }
  ]
}