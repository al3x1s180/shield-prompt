          "context": "line"
        }
      ],
      "safeguards": [
        "GCM",
        "CBC",
        "CTR"
      ],
      "requiresTaint": false
    },
    {
      "ruleId": "hardcoded-iv",
      "severity": "warning",
      "message": "Hardcoded or static IV/nonce used in encryption",
      "detail": "Reusing an IV with the same key allows attackers to recover plaintext. Always generate a random IV per encryption using crypto.randomBytes(16).",
      "cves": [
        {
          "id": "CWE-329",
          "url": "https://cwe.mitre.org/data/definitions/329.html",
          "description": "Not Using an Unpredictable IV with CBC Mode"
        },
        {
          "id": "CWE-338",
          "url": "https://cwe.mitre.org/data/definitions/338.html",
          "description": "Use of Cryptographically Weak PRNG"
        }
      ],
      "patterns": [
        {
          "type": "regex",
          "match": "(?:iv|nonce|IV)\\s*=\\s*(?:Buffer\\.from\\s*\\(\\s*['\"`]|['\"`])[0-9a-fA-F]{16,}['\"`]",
          "flags": "g",
          "context": "line"
        },
        {
          "type": "regex",
          "match": "(?:iv|nonce)\\s*=\\s*(?:Buffer\\.alloc|Buffer\\.from)\\s*\\(\\s*\\d+\\s*,\\s*0\\s*\\)",
