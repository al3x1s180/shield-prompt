      "requiresTaint": false
    },
    {
      "ruleId": "dangerous-set-inner-html",
      "severity": "critical",
      "message": "dangerouslySetInnerHTML with user-controlled content enables XSS",
      "detail": "React's dangerouslySetInnerHTML bypasses all XSS protection. Never pass user input to it directly. Sanitise with DOMPurify before use.",
      "cves": [
