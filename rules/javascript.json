      "requiresTaint": true
    },
    {
      "ruleId": "log-injection",
      "severity": "warning",
      "message": "Log injection: user input written to logs without sanitisation",
      "detail": "Writing unsanitised user input to logs allows log forging \u2014 attackers can inject fake log entries to cover tracks or confuse monitoring. Strip or encode newlines before logging.",
