    {
      "ruleId": "localstorage-sensitive",
      "severity": "warning",
      "message": "Sensitive data stored in localStorage or sessionStorage",
      "detail": "localStorage and sessionStorage are accessible to any JavaScript on the page, including injected scripts. Never store tokens, passwords, or sensitive PII there. Use HttpOnly cookies instead.",
      "cves": [
