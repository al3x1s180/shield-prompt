          "context": "multiline",
          "windowLines": 5
        }
      ],
      "safeguards": [
        "resolveEntities\\s*:\\s*false",
        "forbid_dtd",
        "noent.*false"
      ],
      "requiresTaint": true
    },
    {
      "ruleId": "insecure-cookie",
      "severity": "warning",
      "message": "Cookie set without HttpOnly, Secure, or SameSite flags",
      "detail": "Cookies missing HttpOnly can be stolen via XSS. Missing Secure allows transmission over HTTP. Missing SameSite enables CSRF. Set all three: { httpOnly: true, secure: true, sameSite: 'Strict' }.",
      "cves": [
        {
          "id": "CWE-614",
          "url": "https://cwe.mitre.org/data/definitions/614.html",
          "description": "Sensitive Cookie Without Secure Attribute"
        },
        {
          "id": "CWE-1004",
          "url": "https://cwe.mitre.org/data/definitions/1004.html",
          "description": "Sensitive Cookie Without HttpOnly Flag"
        }
      ],
      "patterns": [
        {
          "type": "regex",
          "match": "res\\.cookie\\s*\\([^)]+\\)(?!.*httpOnly|.*secure|.*sameSite)",
          "flags": "gi",
          "context": "line"
        },
        {
          "type": "regex",
          "match": "document\\.cookie\\s*=(?!.*secure|.*httpOnly)",
          "flags": "gi",
          "context": "line"
        },
        {
          "type": "regex",
          "match": "Set-Cookie:[^\\n]*(?<!HttpOnly)(?<!Secure)(?<!SameSite)",
          "flags": "gi",
          "context": "line"
        }
      ],
      "safeguards": [
        "httpOnly\\s*:\\s*true",
        "secure\\s*:\\s*true",
        "sameSite"
      ],
      "requiresTaint": false
    },
    {
      "ruleId": "crlf-injection",
      "severity": "critical",
      "message": "Potential CRLF / header injection via user-controlled value",
      "detail": "Injecting \\r\\n into HTTP headers allows attackers to forge headers, split responses, or set malicious cookies. Sanitise user input before including it in any header value.",
      "cves": [
        {
          "id": "CWE-113",
          "url": "https://cwe.mitre.org/data/definitions/113.html",
          "description": "Improper Neutralization of CRLF Sequences in HTTP Headers"
        }
      ],
      "patterns": [
        {
          "type": "regex",
          "match": "res\\.(?:set|header|setHeader)\\s*\\([^)]*(?:req\\.|body\\.|params\\.|query\\.)",
