    {
      "ruleId": "ecb-mode",
      "severity": "warning",
      "message": "ECB cipher mode is insecure \u2014 use GCM or CBC instead",
      "detail": "AES-ECB encrypts identical plaintext blocks to identical ciphertext blocks, leaking data patterns. Use AES-GCM (authenticated) or AES-CBC with a random IV.",
      "cves": [
        {
          "id": "CWE-327",
          "url": "https://cwe.mitre.org/data/definitions/327.html",
          "description": "Use of a Broken or Risky Cryptographic Algorithm"
